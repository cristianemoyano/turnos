# Turnos VPS production environment
# Copy to infra/.env.production and fill in values. Never commit infra/.env.production.
#
# Full runbook: docs/deployment/production.md

# --- Docker image ---
GHCR_IMAGE=ghcr.io/cristianemoyano/turnos
STACK_NAME=turnos
DOMAIN=turnos.andiko.cloud
PARENT_DOMAIN=andiko.cloud

# --- PostgreSQL ---
POSTGRES_USER=turnos
POSTGRES_PASSWORD=change-me-generate-with-openssl
POSTGRES_DB=turnos
POSTGRES_DATA_DIR=/var/lib/turnos/postgres

# App DATABASE_URL — optional; built from POSTGRES_* by prod-init if omitted
# DATABASE_URL=postgresql://turnos:change-me@postgres:5432/turnos

# --- App secrets ---
# Generate: openssl rand -base64 32
AUTH_SECRET=change-me-generate-with-openssl
AUTH_URL=https://turnos.andiko.cloud
AUTH_TRUST_HOST=true
NEXT_PUBLIC_BASE_URL=https://turnos.andiko.cloud

# --- Cap (reuse Andiko Cap instance) ---
NEXT_PUBLIC_CAP_HOST=https://cap.andiko.cloud
NEXT_PUBLIC_CAP_SITE_KEY=
CAP_SECRET_KEY=
CAP_VERIFY_URL=https://cap.andiko.cloud/siteverify
# CAP_ADMIN_KEY is read from /root/andiko/infra/.env.production by setup-cap-site.sh

# --- TLS (Certbot — shared with Andiko) ---
CERTBOT_EMAIL=admin@andiko.cloud
CERTBOT_CERTS_DIR=/var/lib/andiko/certs
CERTBOT_WWW_DIR=/var/lib/andiko/certbot-www
NGINX_CONF_DIR=/var/lib/andiko/nginx/conf.d
ANDIKO_STACK_NAME=andiko
