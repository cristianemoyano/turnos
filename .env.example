# Copy this file to .env.local and fill in the values
# Never commit .env.local

# PostgreSQL (local docker-compose maps 5434 → 5432)
DATABASE_URL=postgresql://turnos:turnos@localhost:5434/turnos

# Auth (next-auth v5)
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-in-production
AUTH_URL=http://localhost:3100
AUTH_TRUST_HOST=true

# Public booking base URL (client bundle)
NEXT_PUBLIC_BASE_URL=http://localhost:3100

# Cap (self-hosted invisible CAPTCHA — https://cap.andiko.cloud)
# Off in local dev unless NEXT_PUBLIC_CAP_DEV=true
# NEXT_PUBLIC_CAP_HOST=https://cap.andiko.cloud
# NEXT_PUBLIC_CAP_SITE_KEY=
# CAP_SECRET_KEY=
# CAP_VERIFY_URL=https://cap.andiko.cloud/siteverify
# NEXT_PUBLIC_CAP_DEV=true
